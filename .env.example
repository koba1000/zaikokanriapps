# ダミー値。実際の値は .env（git管理外）または Render の環境変数に設定する
# 生成: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# 生成: flask --app wsgi generate-key
ENCRYPTION_KEY=change-me
# DDL権限を持つマイグレーション専用ロールの接続文字列（アプリ用ロールと分離）
MIGRATION_DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require
# Neon の接続文字列（sslmode=require 必須）
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
